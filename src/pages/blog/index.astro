---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import { webPage, breadcrumb } from '../../lib/schema';
const posts = (await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const title = 'Blog: deal origination guides for M&A advisors and PE firms';
const description = 'Guides on finding off-market sellers, cold email to business owners, pricing and deliverability, written from our own campaign data.';
---
<Base {title} {description} path="/blog/" schema={[webPage(title, '/blog/', description), breadcrumb([{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog/' }])]}>
  <Section>
    <h1>Guides from the work</h1>
    <p class="mt-6 text-lg text-ink-2 max-w-prose">What I learned running outreach to business owners for M&A advisors and PE firms. Real numbers, no client names.</p>
    <ul class="mt-12 grid gap-8 md:grid-cols-2">
      {posts.map((p) => (
        <li class="card overflow-hidden">
          <a href={`/blog/${p.id}/`} class="block">
            <img src={p.data.cover} alt="" width="800" height="450" loading="lazy" class="w-full aspect-[16/9] object-cover" />
            <div class="p-6">
              <p class="mono">{p.data.kind === 'guide' ? 'Guide' : 'Post'} · {p.data.pubDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</p>
              <h2 class="mt-3 text-2xl">{p.data.title}</h2>
              <p class="mt-3 text-muted">{p.data.description}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </Section>
</Base>
