---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ForwardCard from '../components/ForwardCard.astro';
import ReplyQuote from '../components/ReplyQuote.astro';
import FaqList from '../components/FaqList.astro';
import Vsl from '../components/Vsl.astro';
import SystemDiagram from '../components/SystemDiagram.astro';
import Cta from '../components/Cta.astro';
import Mark from '../components/Mark.astro';
import ViewLink from '../components/ViewLink.astro';
import Stamp from '../components/Stamp.astro';
import ReplyGlyph from '../components/ReplyGlyph.astro';
import { site, stats, cta } from '../data/site';
import iconCheck from 'lucide-static/icons/mail-check.svg?raw';
import iconEye from 'lucide-static/icons/list-checks.svg?raw';
import iconShield from 'lucide-static/icons/shield-check.svg?raw';
import { replies } from '../data/replies';
import { faqs } from '../data/faq';
import { service, faqPage, webPage } from '../lib/schema';

const title = 'Konverrt - Deal origination for M&A advisors and PE firms';
const description = 'Business owners who want to talk about a transition, delivered in batches of 10. Per-lead refund, no retainer, month to month. M&A and PE owner outreach, done for you.';
const hero = replies.find((r) => r.n === 8)!;
const strip = [2, 3, 7].map((n) => replies.find((r) => r.n === n)!);
const lead = replies.find((r) => r.n === 4)!;
const homeFaqs = faqs.filter((f) => f.home);
---
<Base {title} {description} path="/" schema={[webPage(title, '/', description), service(), faqPage(homeFaqs)]}>
  <section class="relative overflow-hidden">
    <div class="hero-photo absolute inset-0 -z-10 bg-cover bg-center opacity-35" style="background-image:url('/hero-lisbon.jpg'); mask-image: linear-gradient(to bottom, rgba(0,0,0,.9), rgba(0,0,0,0)); -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,.9), rgba(0,0,0,0));" aria-hidden="true"></div>
    <div class="mx-auto max-w-6xl px-5 pt-14 pb-10 md:pt-20 md:pb-16 grid gap-12 md:grid-cols-[1fr_1.05fr] md:items-center">
    <div>
      <h1 class="h-hero">Owners who said yes to a conversation about selling, delivered <Mark>hot to your inbox</Mark></h1>
      <p class="mt-6 text-lg text-ink-2 max-w-prose">In batches of 10. No retainers. Month to month. Deal origination for M&A advisors and lower-middle-market PE firms: every lead is a business owner who replied in their own words, and any we miss is refunded.</p>
      <div class="mt-8 flex flex-wrap items-center gap-5">
        <a href={cta.href} class="btn btn-primary">{cta.label}</a>
        <a href="/results/" class="link text-sm">See the replies</a>
      </div>
    </div>
    <div class="md:mt-2">
      <Vsl id="6a53843e56f44a4693cc54b7dd84d637" title="How the deal sourcing system works, walked through by Gio" minutes={7} poster="/vsl-poster.jpg" />
    </div>
    </div>
  </section>

  <section class="border-y border-line bg-paper-2/50">
    <dl class="mx-auto max-w-6xl px-5 py-8 grid grid-cols-2 md:grid-cols-4 gap-6">
      {stats.map((s) => (
        <div>
          <dt class="figure text-2xl md:text-3xl tabular-nums">{s.value}</dt>
          <dd class="mt-1 text-sm text-muted">{s.label}</dd>
        </div>
      ))}
    </dl>
  </section>

  <Section title="What lands in your inbox" intro="Each lead is a business owner who replied and said, in their own words, that they are open to talking. We check the company against your criteria, add one line on why it fits, and forward the thread.">
    <div class="grid gap-12 md:grid-cols-[1fr_1.1fr] md:items-center">
      <ul class="space-y-6">
        <li class="flex gap-4"><span class="sys-ico shrink-0" aria-hidden="true" set:html={iconCheck} /><div><h3>Ten conversations, not ten names</h3><p class="mt-1 text-ink-2">A reply that says yes to a call. Out-of-offices, brokers and "remove me" never count.</p></div></li>
        <li class="flex gap-4"><span class="sys-ico shrink-0" aria-hidden="true" set:html={iconEye} /><div><h3>You approve every email</h3><p class="mt-1 text-ink-2">Short and plain, in the owner's language. Nothing sends without your yes.</p></div></li>
        <li class="flex gap-4"><span class="sys-ico shrink-0" aria-hidden="true" set:html={iconShield} /><div><h3>Warm infrastructure, not your domain</h3><p class="mt-1 text-ink-2">Our own aged domains and warmed mailboxes, so emails go out within days. A dedicated set under your name is a one-time setup.</p></div></li>
      </ul>
      <div class="relative mt-14 md:mt-0">
        <Stamp top="Replied" bottom={`step 2 · ${hero.date.slice(5)}/${hero.date.slice(2, 4)}`} />
        <ForwardCard
          note="Owner-operator, privately held manufacturer, Wisconsin. Replied to step 2. Open to a call next week - calendar link sent."
          quote={hero.quote}
          who={hero.who}
          img={hero.img}
        />
      </div>
    </div>
  </Section>

  <Section title="The system that surfaces qualified owners on repeat" mark="on repeat" intro="Five stages, run for every batch. The whole market goes in; only owners who said yes come out." band>
    <SystemDiagram />
    <p class="mt-6"><a href="/how-it-works/" class="link text-sm">What you see at each stage</a></p>
  </Section>

  <Section title="What owners wrote back" mark="wrote back" intro="Unedited replies to emails we sent for clients. Names and companies removed; the words are theirs." loud>
    <figure class="max-w-4xl mb-14">
      <blockquote class="quote-lg flex gap-4"><span class="mt-2 md:mt-3 shrink-0"><ReplyGlyph /></span><span>{lead.quote}</span></blockquote>
      <figcaption class="mt-4 ml-9 text-sm text-muted">{lead.who} · <ViewLink img={lead.img} alt={`Redacted reply: ${lead.who}`} class="link" /></figcaption>
    </figure>
    <div class="desk desk-3">
      {strip.map((r) => <ReplyQuote quote={r.quote} who={r.who} img={r.img} />)}
    </div>
    <p class="mt-6"><a href="/results/" class="link text-sm">All replies and two case studies</a></p>
  </Section>

  <Section title="Who this is for" tight band>
    <div class="grid gap-4 md:grid-cols-2">
      <a href="/for/ma-advisors/" class="card p-6 hover:border-ink block">
        <h3>Sell-side M&A advisors</h3>
        <p class="mt-2 text-ink-2">Owners of $2M to $50M companies in your geography and industries who replied that they are open to a conversation about a transition.</p>
      </a>
      <a href="/for/pe-firms/" class="card p-6 hover:border-ink block">
        <h3>Private equity, independent sponsors, search funds</h3>
        <p class="mt-2 text-ink-2">Owner-run companies that fit your thesis, platform or add-on, whose owner said yes to a call. Proprietary deal sourcing, named or blind.</p>
      </a>
    </div>
  </Section>

  <Section title="Batches of 10. Refund for each we miss. No retainer" tight>
    <p class="max-w-prose text-ink-2">A batch is prepaid. If we deliver eight, you are refunded two or credited to the next batch. Stop whenever you like. Price depends on the search and the size of your market.</p>
    <p class="mt-4"><a href="/pricing/" class="link text-sm">See pricing</a></p>
  </Section>

  <Section title="Common questions" tight>
    <FaqList items={homeFaqs} />
    <p class="mt-6"><a href="/faq/" class="link text-sm">All {faqs.length} questions</a></p>
  </Section>

  <Cta />
</Base>
