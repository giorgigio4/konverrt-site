---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import Section from '../components/Section.astro';
import Cta from '../components/Cta.astro';
import YouTubeFacade from '../components/YouTubeFacade.astro';
import { site } from '../data/site';
import { webPage, breadcrumb } from '../lib/schema';
const title = 'About Konverrt: owner outreach for M&A advisors and PE firms';
const description = 'Hi, I am Gio. I run Konverrt with a small team that researches your market, writes the copy and reads every reply.';
const videos = [
  { id: 'qx8x0Iw7a2s', title: "DON'T work with a cold email agency until you watch this" },
  { id: 'rFOT6ve0gRU', title: 'Cold email setup to NEVER land in spam' },
  { id: 'TVNjdZtkBRQ', title: 'Do This To 10x Your Cold Email Campaign Results' },
  { id: 'tdkEvZu7qmY', title: "I Scraped THOUSANDS of Leads on Crunchbase for FREE (Here's How)" },
];
const refuse = [
  'Count a "remove me", a broker or an out-of-office as a lead',
  'Send the same owner to two clients',
  'Take a success fee or a share of a transaction',
  "Send from your firm's own domain unless you ask for a dedicated set",
  'Make valuation claims in outreach copy',
];
---
<Base {title} {description} path="/about/" schema={[webPage(title, '/about/', description), breadcrumb([{ name: 'Home', path: '/' }, { name: 'About', path: '/about/' }])]}>
  <Section>
    <div class="grid gap-12 md:grid-cols-[1.3fr_1fr] md:items-center">
      <div class="max-w-prose">
        <h1>Hi, I'm Gio. <Mark>I&nbsp;read every reply</Mark></h1>
        <p class="mt-6 text-lg text-ink-2">I'm {site.founder}, and I run Konverrt with a small team. We research your market, write the emails and read every owner reply before it reaches you.</p>
        <p class="mt-4 text-lg text-ink-2">The person on your first call is the person working on your campaign. No account manager in between, no handoff to a junior.</p>
      </div>
      <figure class="max-w-sm w-full md:justify-self-end">
        <img src="/gio.jpg" alt={`${site.founder}, founder of Konverrt`} width="800" height="800" class="portrait" />
        <figcaption class="mt-3 mono">{site.founderShort} · Founder, Konverrt</figcaption>
      </figure>
    </div>
  </Section>

  <Section title="Why I built it this way" tight band>
    <div class="grid gap-10 md:grid-cols-2">
      <p class="text-ink-2 max-w-prose">Most firms I speak with have already paid a lead vendor and got a spreadsheet of names, or a retainer that bought a month of activity. I wanted to sell the thing you actually want: an owner who wrote back and said yes to a conversation.</p>
      <p class="text-ink-2 max-w-prose">So we price per lead, in batches of ten, and refund what we miss. That only works if the list is right and the emails sound like a person wrote them, which is where my time goes.</p>
    </div>
  </Section>

  <Section title="What I won't do" tight>
    <ul class="grid gap-3 md:grid-cols-2 max-w-4xl">
      {refuse.map((r) => (
        <li class="flex gap-3 text-ink-2"><svg class="mt-1 shrink-0 text-accent" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg><span>{r}</span></li>
      ))}
    </ul>

    <p class="mt-10 mono note">{site.name} · Registration number {site.regNumber} · {site.address.street}, {site.address.city}, {site.address.country} · <a href={`mailto:${site.email}`}>{site.email}</a></p>
  </Section>
  <Section title="I also record on YouTube" tight band>
    <p class="text-ink-2 max-w-prose">How we set up cold email, keep it out of spam and pick the right partner. You can also find me on <a class="link" href={site.founderLinkedin} target="_blank" rel="me noopener">LinkedIn</a>.</p>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {videos.map((v) => (
        <figure>
          <YouTubeFacade id={v.id} title={v.title} />
          <figcaption class="mt-3 text-sm text-ink">{v.title}</figcaption>
        </figure>
      ))}
    </div>
    <p class="mt-8"><a class="link" href={site.youtube} target="_blank" rel="me noopener">All videos on YouTube</a></p>
  </Section>
  <Cta />
</Base>
