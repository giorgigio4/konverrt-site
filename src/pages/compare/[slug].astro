---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Cta from '../../components/Cta.astro';
import { compares } from '../../data/compare';
import { webPage, breadcrumb } from '../../lib/schema';
export function getStaticPaths() { return compares.map((c) => ({ params: { slug: c.slug }, props: { c } })); }
const { c } = Astro.props;
const title = `Konverrt vs ${c.name}: deal sourcing compared, with real prices`;
const path = `/compare/${c.slug}/`;
---
<Base {title} description={c.description} {path} schema={[webPage(title, path, c.description), breadcrumb([{ name: 'Home', path: '/' }, { name: 'Compare', path: '/compare/' }, { name: c.name, path }])]}>
  <Section>
    <div class="max-w-prose">
      <p class="mono"><a href="/compare/" class="hover:text-accent">Compare</a> · read on {c.checked}</p>
      <h1 class="mt-3">Konverrt vs {c.name}</h1>
      <p class="mt-6 text-lg text-ink-2">{c.intro}</p>
    </div>
    <div class="mt-12 overflow-x-auto">
      <table class="w-full text-sm border-t border-line">
        <thead><tr class="text-left text-muted"><th class="py-3 pr-4 font-medium w-40"></th><th class="py-3 pr-4 font-medium">Konverrt</th><th class="py-3 font-medium">{c.name}</th></tr></thead>
        <tbody class="divide-y divide-line border-y border-line">
          {c.rows.map((r) => <tr><td class="py-3 pr-4 text-muted align-top">{r[0]}</td><td class="py-3 pr-4 align-top">{r[1]}</td><td class="py-3 align-top">{r[2]}</td></tr>)}
        </tbody>
      </table>
    </div>
    <div class="mt-12 grid gap-10 md:grid-cols-2">
      <div class="max-w-prose"><h2>When to pick {c.name}</h2><p class="mt-3 text-ink-2">{c.pickThem}</p></div>
      <div class="max-w-prose"><h2>When to pick Konverrt</h2><p class="mt-3 text-ink-2">{c.pickUs}</p></div>
    </div>
    <p class="mt-10 mono note">Quotes are from {c.name}'s own pages as read on {c.checked}. If something has changed, write to hello@konverrt.com and we will correct it.</p>
  </Section>
  <Cta />
</Base>
