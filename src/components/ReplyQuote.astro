---
import ReplyGlyph from './ReplyGlyph.astro';
import ViewLink from './ViewLink.astro';
interface Props { quote: string; who: string; img?: string; size?: 'base' | 'lg' }
const { quote, who, img, size = 'base' } = Astro.props;
---
<figure class="card p-5 md:p-6 flex flex-col gap-4 h-full">
  <div class="flex gap-3">
    <span class="mt-1"><ReplyGlyph /></span>
    <blockquote class:list={['text-ink', size === 'lg' ? 'text-lg' : 'text-base']}>{quote}</blockquote>
  </div>
  <figcaption class="mt-auto flex items-end justify-between gap-4 text-sm text-muted">
    <span>{who}</span>
    {img && <ViewLink img={img} alt={`Redacted reply: ${who}`} />}
  </figcaption>
</figure>
