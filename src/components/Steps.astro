---
interface Props { items: { t: string; d: string }[] }
const { items } = Astro.props;
---
<ol class="border-t border-line">
  {items.map((s, i) => (
    <li class="grid gap-2 md:grid-cols-[48px_220px_1fr] md:gap-6 py-5 border-b border-line">
      <span class="mono">{String(i + 1).padStart(2, '0')}</span>
      <h3 class="text-base font-medium">{s.t}</h3>
      <p class="text-ink-2 max-w-prose">{s.d}</p>
    </li>
  ))}
</ol>
