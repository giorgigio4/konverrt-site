---
interface Props { title?: string; intro?: string; id?: string; tight?: boolean; class?: string }
const { title, intro, id, tight = false, class: cls = '' } = Astro.props;
---
<section id={id} class:list={['mx-auto max-w-6xl px-5', tight ? 'py-12' : 'py-16 md:py-20', cls]}>
  {title && <div class="max-w-prose mb-8"><h2>{title}</h2>{intro && <p class="mt-3 text-muted">{intro}</p>}</div>}
  <slot />
</section>
