---
import Mark from './Mark.astro';
interface Props { title?: string; mark?: string; intro?: string; id?: string; tight?: boolean; loud?: boolean; band?: boolean; class?: string }
const { title, mark, intro, id, tight = false, loud = false, band = false, class: cls = '' } = Astro.props;
// mark: a phrase inside title that gets the hand-drawn underline (exact substring, once)
const [pre, post] = title && mark && title.includes(mark) ? [title.slice(0, title.indexOf(mark)), title.slice(title.indexOf(mark) + mark.length)] : [title, ''];
const pad = loud ? 'py-20 md:py-28' : tight ? 'py-12 md:py-14' : 'py-16 md:py-20';
---
<div class:list={[band && 'band']}>
  <section id={id} class:list={['mx-auto max-w-6xl px-5', pad, cls]}>
    {title && <div class="max-w-3xl mb-10"><h2>{pre}{mark && title.includes(mark) && <Mark>{mark}</Mark>}{post}</h2>{intro && <p class="mt-4 text-muted max-w-prose">{intro}</p>}</div>}
    <slot />
  </section>
</div>
