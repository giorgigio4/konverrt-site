---
import '../styles/global.css';
import { site, nav, cta } from '../data/site';
import { organization } from '../lib/schema';

interface Props { title: string; description: string; path: string; schema?: object[]; noindex?: boolean }
const { title, description, path, schema = [], noindex = false } = Astro.props;
const canonical = `${site.url}${path}`;
const og = `${site.url}/og.png`;
const ld = [organization(), ...schema];
const current = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- RSS link added when the insights section ships -->
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="color-scheme" content="dark light" />
    <script is:inline>
      // Dark is the default for everyone; a visitor's own toggle choice is remembered.
      (function () { try {
        var m = localStorage.getItem('k-mode');
        if (m === 'light') document.documentElement.setAttribute('data-mode', 'light');
      } catch (e) {} })();
    </script>
    {ld.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:bg-card focus:px-3 focus:py-2">Skip to content</a>
    <header class="border-b border-line">
      <div class="mx-auto max-w-6xl px-5 h-16 flex items-center justify-between gap-6">
        <a href="/" class="wordmark" aria-label="Konverrt home">Konverrt</a>
        <nav class="hidden md:flex items-center gap-7 text-sm" aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} class:list={['border-b pb-0.5', current(n.href) ? 'border-ink text-ink' : 'border-transparent text-muted hover:text-ink']}>{n.label}</a>
          ))}
        </nav>
        <div class="flex items-center gap-3">
          <button type="button" id="mode-btn" class="mode-btn" aria-label="Switch light or dark mode" title="Light / dark">
            <svg class="i-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="i-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>
          </button>
          <a href={cta.href} class="btn btn-primary h-10">{cta.label}</a>
          <details class="md:hidden relative">
            <summary class="list-none cursor-pointer h-10 w-10 grid place-items-center rounded-sm border border-line-2" aria-label="Menu">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            </summary>
            <div class="absolute right-0 mt-2 w-56 card p-2 shadow-ink z-20">
              {nav.map((n) => <a href={n.href} class="block px-3 py-2 rounded-sm text-sm hover:bg-paper-2">{n.label}</a>)}
            </div>
          </details>
        </div>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-line mt-24">
      <div class="mx-auto max-w-6xl px-5 py-12 grid gap-10 md:grid-cols-4 text-sm">
        <div class="space-y-3">
          <div class="wordmark">Konverrt</div>
          <p class="text-muted">Deal origination for M&A advisors and lower-middle-market PE firms. M&A and PE owner outreach, done for you.</p>
          <p class="mono">{site.name} · Reg. {site.regNumber}<br />{site.address.street}, {site.address.city}, {site.address.country}</p>
          <p><a class="link" href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
        <div>
          <div class="mb-3 text-muted">Site</div>
          <ul class="space-y-2">
            {nav.map((n) => <li><a href={n.href} class="hover:text-accent">{n.label}</a></li>)}
            <li><a href="/about/" class="hover:text-accent">About</a></li>
            <li><a href="/apply/" class="hover:text-accent">Apply</a></li>
          </ul>
        </div>
        <div>
          <div class="mb-3 text-muted">For</div>
          <ul class="space-y-2">
            <li><a href="/for/ma-advisors/" class="hover:text-accent">Sell-side M&A advisors</a></li>
            <li><a href="/for/pe-firms/" class="hover:text-accent">Private equity firms</a></li>
            <li><a href="/compare/" class="hover:text-accent">Compare vendors</a></li>
          </ul>
        </div>
        <div>
          <div class="mb-3 text-muted">Elsewhere</div>
          <ul class="space-y-2">
            <li><a href={site.youtube} target="_blank" rel="me noopener" class="hover:text-accent">YouTube</a></li>
            <li><a href={site.linkedin} target="_blank" rel="me noopener" class="hover:text-accent">LinkedIn</a></li>
          </ul>
        </div>
      </div>
      <div class="mx-auto max-w-6xl px-5 pb-8 mono">© {new Date().getFullYear()} Konverrt. All rights reserved.</div>
    </footer>

    <script is:inline>
      (function () { var b = document.getElementById('mode-btn'); if (!b) return;
        b.addEventListener('click', function () {
          var h = document.documentElement, light = h.getAttribute('data-mode') !== 'light';
          if (light) h.setAttribute('data-mode', 'light'); else h.removeAttribute('data-mode');
          try { localStorage.setItem('k-mode', light ? 'light' : 'dark'); } catch (e) {}
          b.setAttribute('aria-label', light ? 'Switch to dark mode' : 'Switch to light mode');
        });
      })();
    </script>

    <script is:inline define:vars={{ ga: site.ga4, px: site.fbPixel }}>
      window.addEventListener('load', () => {
        setTimeout(() => {
          const s = document.createElement('script'); s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga; document.head.appendChild(s);
          window.dataLayer = window.dataLayer || []; function gtag(){ dataLayer.push(arguments); } window.gtag = gtag; gtag('js', new Date()); gtag('config', ga);
          !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
          fbq('init', px); fbq('track', 'PageView');
        }, 1500);
      });
    </script>
    <dialog id="viewer" class="viewer" aria-label="Owner reply">
      <div class="viewer-bar">
        <span class="mono"><span class="hidden md:inline">Redacted owner reply · names and companies removed</span><span class="md:hidden">Redacted reply · swipe to read</span></span>
        <button type="button" class="viewer-close" data-close>Close <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
      </div>
      <div class="viewer-body"><img alt="" /></div>
    </dialog>
    <script>
      const dlg = document.getElementById('viewer') as HTMLDialogElement | null;
      if (dlg && typeof dlg.showModal === 'function') {
        const img = dlg.querySelector('img') as HTMLImageElement;
        document.addEventListener('click', (e) => {
          const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-view]');
          if (!a || e.metaKey || e.ctrlKey || e.shiftKey) return;
          e.preventDefault();
          img.src = a.dataset.view || a.href; img.alt = a.dataset.alt || 'Redacted owner reply';
          dlg.showModal();
        });
        dlg.addEventListener('click', (e) => { if (e.target === dlg || (e.target as HTMLElement).closest('[data-close]')) dlg.close(); });
        dlg.addEventListener('close', () => { img.removeAttribute('src'); });
      }
    </script>
  </body>
</html>
